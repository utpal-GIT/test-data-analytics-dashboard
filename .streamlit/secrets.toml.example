# Copy to .streamlit/secrets.toml (that file is gitignored) and fill in.
# On Streamlit Cloud paste the same content into Settings -> Secrets.

# ---------------------------------------------------------------------------
# External database (optional)
# ---------------------------------------------------------------------------
# Leave this section out to use the local SQLite file app_data.db.
# Set it to keep data across restarts on a host with an ephemeral disk.
# Neon gives you this string under "Connection string" - use the pooled one.
[database]
url = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Synced into the users table on every startup, so the app always has a way
# in even on a fresh database. Passwords are hashed before they are stored.
[users.admin]
password = "change-me"
role = "admin"

# [users.analyst1]
# password = "their-password"
# role = "user"
